# VSDream Configuration Template
# Copy to .dream-config and edit as needed

# Memory scope to consolidate:
#   user    — /memories/ (persistent, cross-workspace) [default]
#   repo    — /memories/repo/ (per-repository, current workspace or --workspace)
#   session — /memories/session/ (current conversation only, rarely useful)
# Runtime flag: --scope user|repo|session
DREAM_MEMORY_SCOPE=user

# Default workspace(s) for --scope repo (comma-separated repo paths or names)
# Leave empty to use the current workspace
# Runtime flag: --workspace /path/to/repo (can be repeated for multiple)
DREAM_WORKSPACES=

# Repositories to exclude from session scanning (comma-separated repo paths or names)
# Prevents self-referential noise — e.g. exclude VSDream so its own dev sessions
# don't pollute global user memory with project-specific details
# Runtime flag: --exclude VSDream (can be repeated)
DREAM_EXCLUDE=

# If true, --scope repo dreams iterate all known repositories from the session store
# Runtime flag: --all
DREAM_ALL=false

# How far back to scan sessions in the cloud session store:
#   1 day, 7 days, 30 days, 90 days, or "all"
# Runtime flag: --window 30 days
DREAM_WINDOW=7 days

# Minimum hours between automatic dreams
DREAM_INTERVAL_HOURS=24

# Whether a dream is allowed to write to memory.
#   false — every dream is a preview only; nothing is written [default]
#   true  — the dream writes its findings to memory
# Runtime flag: --apply (forces true for a single run, regardless of this setting)
DREAM_APPLY=false

# Maximum lines per memory file before splitting by sub-topic
DREAM_MAX_LINES=200