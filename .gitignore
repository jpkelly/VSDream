# ─── Dream runtime artifacts ───
# These are created when running the dream from within this repo.
# They are NOT part of the release and should never be committed.

# Dream state
.last-dream
.dream-pending
.dream-config

# Dream logs
logs/
*.log

# Dream test fixtures (created by test-dream.sh)
test-fixtures/

# Per-repo dream timestamps and state
repos/

# ─── OS / editor files ───
__pycache__/
*.pyc
.DS_Store
*.swp
*~
*.swo
Thumbs.db